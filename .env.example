# ==============================================================================
# AskLens: AI Data Analyst Platform - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=asklens
POSTGRES_USER=asklens_admin
POSTGRES_PASSWORD=asklens_secure_password_123

# Read-only role credentials (used by the SQL execution agent)
POSTGRES_READONLY_USER=warehouse_readonly
POSTGRES_READONLY_PASSWORD=readonly_secure_password_123

# Connection URLs
# App connection URL (reads/writes to app schema)
DATABASE_URL=postgresql+asyncpg://asklens_admin:asklens_secure_password_123@localhost:5432/asklens
# Warehouse read-only connection URL (only SELECT on warehouse schema)
WAREHOUSE_READONLY_URL=postgresql://warehouse_readonly:readonly_secure_password_123@localhost:5432/asklens

# Query Safety Defaults
STATEMENT_TIMEOUT_MS=5000
MAX_ROW_LIMIT=500
MAX_QUERY_COST=50000.0

# ------------------------------------------------------------------------------
# LLM Providers Configuration
# Provider selection: gemini | ollama | openai_compat
# The system supports automatic fallback if the primary provider hits rate limits
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=ollama

# Google Gemini (Free Tier: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Ollama Local Models (e.g. qwen2.5-coder:7b, llama3.1:8b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# OpenAI-Compatible Free Endpoints (e.g. Groq, OpenRouter)
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=your_groq_or_openrouter_api_key
OPENAI_COMPAT_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# NextAuth / Auth.js (Frontend)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super_secret_nextauth_key_change_me_in_production

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Speech-to-Text (STT) Settings
# ------------------------------------------------------------------------------
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
